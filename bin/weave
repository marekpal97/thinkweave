#!/bin/sh
# Plugin CLI shim.
#
# Claude Code adds an enabled plugin's bin/ to the Bash tool's PATH, so skills
# and agents can invoke bare `weave …` and have it resolve from ANY working
# directory — on both the marketplace and dev-link (@skills-dir) routes.
#
# This shim is necessary because ${CLAUDE_PLUGIN_ROOT} is substituted only in
# hook commands and MCP/LSP configs — NOT in slash-command or subagent Bash
# calls — and the `weave` console script lives in the plugin's own venv, not on
# the user's PATH. We resolve the plugin root from this script's own location
# (cd -P follows the dev-link symlink to the real checkout) and run the bundled
# CLI via uv. `uv run weave` resolves the venv's console script, not this shim,
# so there is no recursion.
#
# uv resolution matches bin/weave-mcp-launch (#52): PATH -> ~/.local/bin/uv ->
# $UV_INSTALL_DIR/uv, loud failure otherwise. Harness shells frequently lack
# ~/.local/bin on PATH (non-login shells); a bare `uv` here would make every
# CLI call routed through this shim — /wrap's `weave wrap-finalize` first among
# them (#47) — fail with a confusing "uv: command not found" or nothing at all.
# Self-location is shell-builtin-only (no dirname) — same as
# bin/weave-mcp-launch — so the shim still works on minimal harness shells
# with a stripped PATH.
set -eu
case $0 in
    */*) script_dir=${0%/*} ;;
    *)   script_dir=. ;;
esac
root="$(CDPATH='' cd -P -- "$script_dir/.." && pwd)"

if command -v uv >/dev/null 2>&1; then
    uv_bin=$(command -v uv)
elif [ -x "${HOME:-}/.local/bin/uv" ]; then
    uv_bin="$HOME/.local/bin/uv"
elif [ -n "${UV_INSTALL_DIR:-}" ] && [ -x "$UV_INSTALL_DIR/uv" ]; then
    uv_bin="$UV_INSTALL_DIR/uv"
else
    echo 'bin/weave: uv not found (checked PATH, ~/.local/bin/uv, $UV_INSTALL_DIR/uv); install uv from https://docs.astral.sh/uv/getting-started/installation/ or add it to PATH' >&2
    exit 127
fi

# One-time dependency bootstrap (#164, matches bin/weave-{hook,mcp}-launch):
# a fresh plugin/marketplace clone has no venv, and `uv run --no-sync` would
# fabricate an EMPTY one and die with ModuleNotFoundError. Sentinel = an
# installed thinkweave distribution (site-packages/thinkweave-*.dist-info,
# either venv layout — the marker editable installs ship too; they have no
# site-packages/thinkweave/). NOT the console scripts: uv deletes those FIRST
# during a project reinstall (docs/HARNESSES.md os-error-32 incident), and the
# resulting half-shimmed venv still runs fine via `python -m` — it must never
# re-fire a sync that dies while live servers hold the shims. The sync is the
# ONE sanctioned shape (dec-3d4f8ce9): `--extra all`, never per-call, never
# narrower. Breadcrumb + sync output on stderr: stdout belongs to the caller,
# and a hook killed at its timeout mid-sync must leave a diagnosable trace.
# ponytail: a sync killed exactly between dist-info removal and re-creation
# re-fires the bootstrap on the next launch; uv's venv lock + warm cache make
# that retry converge. Upgrade path: a success stamp the bootstrap writes.
installed=no
for marker in "$root"/.venv/lib/python*/site-packages/thinkweave-*.dist-info \
              "$root"/.venv/Lib/site-packages/thinkweave-*.dist-info; do
    if [ -e "$marker" ]; then installed=yes; fi
done
if [ "$installed" = no ]; then
    echo 'weave: first-run bootstrap: uv sync --extra all (a cold cache can take minutes; a killed attempt resumes at the next launch)' >&2
    "$uv_bin" sync --project "$root" --extra all 1>&2
fi

# --no-sync + module entry (matches bin/weave-{hook,mcp}-launch, #156/#164):
# a plain `uv run --extra mcp weave` re-syncs the venv to ONLY the mcp extra on
# every call, silently uninstalling news/embeddings/gemini/youtube deps — this
# killed the news pull on 2026-08-11 and the embed/dream crons on 2026-08-22.
# Sync happens once, explicitly: `uv sync --extra all` (bootstrap above / README).
exec "$uv_bin" run --no-sync --project "$root" --extra mcp python -m thinkweave "$@"
