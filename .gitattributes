# POSIX launchers are executed by Git Bash on Windows.
bin/* text eol=lf

# The Windows batch launchers must be CRLF. cmd.exe is only reliable on CRLF —
# a LF-only .cmd mis-parses the multi-line `if (…) else (…)` block in the
# uv-resolution ladder — so these are pinned regardless of checkout platform.
#
# This rule is deliberately MORE specific than, and must sort after, the
# `bin/* text eol=lf` rule that pins the POSIX launchers (added in #156): later
# rules win in .gitattributes, and `bin/*` would otherwise match these too and
# force them to LF.
*.cmd                text eol=crlf
