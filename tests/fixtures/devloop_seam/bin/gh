#!/usr/bin/env python3
"""Offline ``gh`` for the #346 demo: serves ``../issue.json`` for the reads
devloop and ``weave task record-run`` make, and refuses everything else, so a
run with this first on PATH cannot touch GitHub."""
import json
import sys
from pathlib import Path

ISSUE = json.loads((Path(__file__).resolve().parent.parent / "issue.json").read_text())
args = sys.argv[1:]
number = str(ISSUE["number"])
target = args[1] if len(args) > 1 else ""

if args[:2] == ["issue", "view"] and args[2:3] == [number]:
    print(json.dumps({"title": ISSUE["title"], "body": ISSUE["body"]}))
elif args[:1] == ["api"] and target.endswith(f"/issues/{number}/parent"):
    print("gh: Not Found (HTTP 404)", file=sys.stderr)
    sys.exit(1)
elif args[:1] == ["api"] and target.endswith(f"/issues/{number}"):
    if "-q" not in args:
        print(json.dumps(ISSUE))
    elif args[args.index("-q") + 1] == ".state":
        print(ISSUE["state"])
    else:
        print(json.dumps({"sub_issues_summary": ISSUE["sub_issues_summary"],
                          "parent_issue_url": ISSUE["parent_issue_url"]}))
else:
    print(f"gh fixture stub: refusing {' '.join(args)!r} (offline demo)", file=sys.stderr)
    sys.exit(1)
