{
  "loop": {
    "max_issues_per_run": 3,
    "max_parallel": 1,
    "max_fix_rounds": 2,
    "training_mode": true,
    "draft_pr": true,
    "branch_prefix": "loop/issue-",
    "require_green_baseline": true,
    "claim_mode": "assign",
    "run_mode": "pass",
    "delivery": "pr-per-issue",
    "prime_holdout": 5
  },
  "labels": {
    "runnable": "ready-for-agent",
    "claimed": "agent-claimed",
    "on_gate_failure": "ready-for-human"
  },
  "tdd": {
    "mode": "auto"
  },
  "dispatch": {
    "persona": true
  },
  "triage": {
    "green_enabled": false,
    "sensitive_paths": [
      "hooks/",
      "src/thinkweave/surfaces/",
      "ontology.yaml",
      "sources.yaml",
      "*schema*"
    ],
    "watched_paths": [],
    "green_max_diff_lines": 150,
    "green_requires_first_try": true,
    "red_min_diff_lines": 800
  },
  "gates": [
    {
      "id": "diff-guard",
      "kind": "diff",
      "required": true,
      "forbidden_paths": [
        ".github/workflows/",
        "dist/",
        "_old/"
      ],
      "max_changed_lines": 2000
    },
    {
      "id": "tests",
      "kind": "command",
      "required": true,
      "cmd": "uv run --extra mcp pytest -x -q",
      "timeout_sec": 1200
    },
    {
      "id": "acceptance",
      "kind": "acceptance",
      "required": true,
      "threshold": "all"
    },
    {
      "id": "review",
      "kind": "review",
      "required": true,
      "block_on": [
        "critical",
        "major"
      ],
      "smells_baseline": true
    },
    {
      "id": "simplify",
      "kind": "simplify",
      "required": false,
      "skill": "ponytail-review",
      "rerun": [
        "tests",
        "acceptance"
      ],
      "revert_note": "\u26a0 simplify-reverted"
    }
  ]
}
