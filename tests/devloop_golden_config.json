{
  "loop": {
    "max_issues_per_run": 3,
    "max_parallel": 1,
    "max_fix_rounds": 2,
    "training_mode": true,
    "branch_prefix": "loop/issue-",
    "require_green_baseline": true,
    "run_mode": "pass",
    "delivery": "pr-per-issue"
  },
  "labels": {
    "runnable": "ready-for-agent",
    "claimed": "agent-claimed",
    "on_gate_failure": "ready-for-human"
  },
  "tdd": {
    "mode": "auto"
  },
  "triage": {
    "sensitive_paths": [
      "hooks/",
      "src/thinkweave/surfaces/",
      "ontology.yaml",
      "sources.yaml",
      "*schema*"
    ],
    "watched_paths": [
      "docs/agents/"
    ],
    "red_min_diff_lines": 800
  },
  "gates": [
    {
      "id": "diff-guard",
      "kind": "diff",
      "required": true,
      "forbidden_paths": [
        ".github/workflows/",
        "dist/",
        "_old/"
      ]
    },
    {
      "id": "tests",
      "kind": "command",
      "required": true,
      "cmd": "uv run --extra mcp pytest -x -q",
      "timeout_sec": 1200
    },
    {
      "id": "judge",
      "kind": "judge",
      "required": true,
      "threshold": "all"
    },
    {
      "id": "simplify",
      "kind": "simplify",
      "required": false,
      "skill": "ponytail-review",
      "rerun": [
        "tests"
      ],
      "revert_note": "\u26a0 simplify-reverted"
    }
  ]
}
